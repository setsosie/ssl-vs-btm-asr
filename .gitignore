__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# data + weights are large / public — fetch via `make fetch`, never commit.
# Anchored: an unanchored `data/` also matched src/svb/data/ and hid the entire
# data package from the repository.
/data/
checkpoints/
*.pth
*.pt
*.safetensors

# run outputs (JSON results are reproducible; aggregated tables are committed)
results/*
!results/.gitkeep

# Planning notes are kept local, not published. They are working material, not
# documentation: they go stale between edits and say more about scheduling than
# about the code. ROADMAP.md is the published statement of what is planned.
docs/planning/
scripts/verify/
