__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# data + weights are large / public — fetch via `make fetch`, never commit.
# Anchored: an unanchored `data/` also matched src/svb/data/ and hid the entire
# data package from the repository.
/data/
checkpoints/
*.pth
*.pt
*.safetensors

# Per-run outputs under results/ are regenerated by re-running, so they are not
# committed; aggregated tables live in tables/, which is committed.
results/*
!results/.gitkeep
